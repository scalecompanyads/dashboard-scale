# Supabase — public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://yogjyumivrygbnexhqsn.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_L2lWKENhdg2E18f5O7YLGQ_yALT937o

# Supabase — server-only secret. Supabase Dashboard -> Project Settings -> API
# -> "service_role" key. Never expose this to the browser / NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# Monday.com API token (same one used by the legacy Netlify function)
MONDAY_TOKEN=

# Meta Ads (Facebook Graph API) — same credentials used by the legacy Netlify function
META_ADS_TOKEN=
META_AD_ACCOUNT_ID=

# Protects /api/cron/sync from public invocation. MUST be named exactly
# CRON_SECRET — when a Vercel Cron Job hits this project, Vercel automatically
# attaches `Authorization: Bearer $CRON_SECRET` using whatever value is set
# for an env var with this exact name. Generate one with:
#   openssl rand -base64 32
CRON_SECRET=

# ---------------------------------------------------------------------------
# CRM interno (OUTRO projeto Supabase) — segunda fonte de leads
#
# O dashboard nasceu lendo só o board do Monday. O CRM interno entrou em
# produção com os mesmos leads (foi migrado do mesmo board) e passou a ser
# onde o time trabalha, então ele alimenta a tabela `leads` daqui em paralelo
# com o Monday — ver lib/sync/crm.ts.
#
# É a URL e a service-role key do projeto do CRM, NÃO deste. A key só faz
# SELECT (lib/supabase/crm.ts); o dashboard nunca escreve no CRM.
CRM_SUPABASE_URL=
CRM_SUPABASE_SERVICE_ROLE_KEY=

# Personal Access Token da conta Supabase (https://supabase.com/dashboard/
# account/tokens). Usado só por `npm run db:push`, que aplica
# supabase/migrations pela Management API — a service-role key não serve
# aqui, ela fala com o PostgREST, que não roda DDL.
SUPABASE_ACCESS_TOKEN=
